# ---- Shared ----
NODE_ENV=development

# ---- Postgres ----
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_dev_password
POSTGRES_DB=crm_platform
POSTGRES_PORT=5432
DATABASE_URL=postgresql://crm:crm_dev_password@localhost:5432/crm_platform?schema=public

# ---- Redis ----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- API (apps/api) ----
API_PORT=4000
JWT_ACCESS_SECRET=change_me_access_secret_dev_only_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGIN=http://localhost:3000

# ---- Web (apps/web) ----
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
